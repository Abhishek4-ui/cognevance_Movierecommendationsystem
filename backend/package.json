{
  "name": "ai-movie-recommendation-backend",
  "version": "1.0.0",
  "description": "Production Node.js & Express Backend for AI/ML Movie Recommendation System",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --detectOpenHandles --rootDir ../"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "<rootDir>/tests/backend/**/*.test.js",
      "<rootDir>/tests/ai-engine/**/*.test.js"
    ],
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/backend/node_modules"
    ]
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0",
    "nodemailer": "^6.10.0",
    "razorpay": "^2.9.5",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
