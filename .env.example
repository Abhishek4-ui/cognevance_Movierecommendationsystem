# ==========================================
# CineAI Environment Variables Reference
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/ai_movie_rec

# Security & Authentication (JWT Secret Keys)
JWT_ACCESS_SECRET=cinerec_super_secret_access_jwt_key_987654321_production
JWT_REFRESH_SECRET=cinerec_super_secret_refresh_jwt_key_123456789_production

# Genuine External Movie APIs
TMDB_API_KEY=
OMDB_API_KEY=
YOUTUBE_API_KEY=

# LLM & AI Configuration
OPENAI_API_KEY=

# Email Delivery (SMTP or Ethereal for testing)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
